<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false">

        <!-- Profile Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/primary_lightest"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Profile Avatar -->
                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Nodare Enterprise Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_nodare_signin" />

                <!-- Role Badge -->
                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    android:background="@drawable/bg_status_chip"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- User Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/primary_lightest"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Account Information"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Display Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Name"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/primary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp"
                    android:paddingStart="2dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfileName"
                    style="@style/NodareTextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    app:hintEnabled="false"
                    app:errorEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:enabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfileEmail"
                    style="@style/NodareTextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:errorEnabled="false"
                    app:startIconDrawable="@android:drawable/sym_action_email"
                    app:startIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:enabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- User ID (Read-only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        android:tint="@color/primary"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="User ID" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User ID"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvProfileUserId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="UID123456"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Save Button (Hidden by default) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/primary" />

                <ProgressBar
                    android:id="@+id/progressProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/primary_lightest"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actions"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:layout_marginBottom="16dp" />

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/NodareOutlinedButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Sign Out"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error"
                    app:strokeColor="@color/error"
                    android:textColor="@color/error" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="Nodare GeoSec v1.0.0"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:alpha="0.7" />
            
        <!-- Spacer to ensure content clears bottom nav -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="100dp" />
    </LinearLayout>
</ScrollView>
